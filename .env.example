# Copy to .env. Placeholder values only.
PORT=3001
# Where the SQLite file lives. Never committed.
DATABASE_PATH=./data/apex.db
# Shows demo credentials on the login screen and the "mark complete as" button.
DEMO_MODE=true
# The web app origin, used for the Origin check on mutating requests.
# On Render this is filled in for you. More than one address can be listed, separated by commas, such as a phone on your network.
APP_ORIGIN=http://localhost:5173

# Where uploaded files are stored. Never committed.
UPLOADS_DIR=./uploads

# Behind a proxy or host that forwards requests, set how many proxies sit in front (usually 1).
TRUST_PROXY=0

# Live map. "mock" draws a simulated truck. "samsara" is a stub that is not connected to anything yet.
TRACKING_PROVIDER=mock
# How many times faster than real time the simulated truck travels. Defaults to 1000 in demo mode and 1 otherwise.
# TRACKING_SPEEDUP=1000
# Only for the future Samsara connection. Never commit a real token.
# SAMSARA_API_TOKEN=
