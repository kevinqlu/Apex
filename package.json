{
  "name": "apex-driver-portal",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,blue \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "cross-env NODE_ENV=production npm run start -w server",
    "start:demo": "npm run seed && npm start",
    "seed": "npm run seed -w server",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "format": "prettier --write .",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
